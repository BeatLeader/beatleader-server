<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>BeatLeader_Server.Tests</RootNamespace>
    <!-- The rebalanced RatingAPI (portaBLe/RatingAPI, branch loloppe-rebalancer): its pp code is compiled in for parity tests -->
    <RatingApiReworkDir Condition="'$(RatingApiReworkDir)' == ''">$(MSBuildThisFileDirectory)..\..\portaBLe\RatingAPI\</RatingApiReworkDir>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(RatingApiReworkDir)Pp\PpCalculator.cs')">
    <DefineConstants>$(DefineConstants);RATINGAPI_PARITY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeatLeader-Server.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(RatingApiReworkDir)Pp\PpCalculator.cs')">
    <Compile Include="$(RatingApiReworkDir)Pp\PpFormula.cs" Link="RatingApiRework\PpFormula.cs" />
    <Compile Include="$(RatingApiReworkDir)Pp\PpCalculator.cs" Link="RatingApiRework\PpCalculator.cs" />
    <Compile Include="$(RatingApiReworkDir)Pp\ModifiersMap.cs" Link="RatingApiRework\ModifiersMap.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
